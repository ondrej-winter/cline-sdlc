# Safe example settings for live Cline SDK adapter smoke tests.
#
# Copy this file to .env for local experimentation only. Do not commit real
# credentials, private endpoints, tokens, or provider-specific secrets.

# Required for live SDK smoke/example runs.
CLINE_SDK_PROVIDER_ID=openai-codex-cli
CLINE_SDK_MODEL_ID=gpt-5.5

# Optional provider hint used only when supported by the configured provider.
CLINE_SDK_REASONING_EFFORT=medium

# Optional credentials/settings for providers that require them. Keep placeholders
# safe and never store production secrets in this repository.
CLINE_SDK_API_KEY=sk-example-placeholder
CLINE_SDK_BASE_URL=https://example.invalid/v1
